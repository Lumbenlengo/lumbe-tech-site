{
  "hosting": {
    "target": "lumbetech",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "run": {
          "serviceId": "lumbe-lead-intake",
          "region": "europe-west1"
        }
      }
    ]
  }
}
